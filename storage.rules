rules_version = '2';
// Food photos: anyone with a photo's unguessable link can see it (like the artifact did);
// only the household can add or remove them. The first household's photos are at assets/<id>,
// every other household's at households/<hid>/assets/<id> (10 Nov 2026).
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function owner() { return verified() && request.auth.token.email.lower() == '__OWNER_EMAIL__'; }
    function member() {
      return owner() || (verified()
        && request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/access/members).data.emails);
    }
    function inHouse(hid) {
      return verified() && request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/households/$(hid)).data.members;
    }
    function photo() { return request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /assets/{id} {
      allow read: if true;
      allow create, update: if member() && photo();
      allow delete: if member();
    }
    match /households/{hid}/assets/{id} {
      allow read: if true;
      allow create, update: if inHouse(hid) && photo();
      allow delete: if inHouse(hid);
    }
  }
}
